{
  "name": "@camp-platform/web",
  "version": "1.0.0",
  "description": "Camp Platform web app — Next.js 14 frontend with in-process tRPC API",
  "private": true,
  "scripts": {
    "build": "cd ../database && npx prisma generate && cd ../web && next build",
    "postinstall": "cd ../database && npx prisma generate",
    "dev": "next dev -p 3006",
    "prestart": "node scripts/ensure-next-build.mjs",
    "start": "next start",
    "smoke:deploy": "node scripts/smoke-deploy.mjs",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "type-check": "tsc --noEmit",
    "export:master-doc": "tsx scripts/export-master-doc.ts"
  },
  "dependencies": {
    "@camp-platform/database": "file:../database",
    "@next/third-parties": "^14.2.35",
    "@paypal/react-paypal-js": "^8.7.0",
    "@prisma/client": "^5.3.1",
    "@sendgrid/mail": "^8.1.0",
    "@tanstack/react-query": "^4.36.1",
    "@trpc/client": "^10.38.1",
    "@trpc/react-query": "^10.38.1",
    "@trpc/server": "^10.38.1",
    "autoprefixer": "^10.4.16",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.0",
    "framer-motion": "^10.17.0",
    "googleapis": "^172.0.0",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "konva": "^9.3.22",
    "lucide-react": "^0.303.0",
    "next": "14.0.4",
    "next-themes": "^0.4.6",
    "nodemailer": "^6.9.7",
    "postcss": "^8.4.32",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-konva": "^18.2.16",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "stripe": "^22.1.1",
    "superjson": "^2.2.1",
    "tailwind-merge": "^2.2.0",
    "tailwindcss": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "xlsx": "^0.18.5",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.5.0",
    "@types/nodemailer": "^6.4.14",
    "@types/react": "^18.2.21",
    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "eslint": "^8.47.0",
    "eslint-config-next": "13.4.19",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "playwright": "^1.56.0",
    "ts-jest": "^29.4.6",
    "tsx": "^3.14.0",
    "typescript": "^5.1.6"
  }
}
