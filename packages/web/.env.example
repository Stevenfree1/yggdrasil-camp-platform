# =============================================================================
# Camp Platform: environment variables
# Copy to .env (never commit real values). Placeholders only below.
# Camp identity (name, domain, email, etc.) lives in config/camp.config.ts,
# not here.
# =============================================================================

# --- Core (required) ---------------------------------------------------------
# PostgreSQL connection string (read by Prisma).
DATABASE_URL="postgresql://postgres:password@localhost:5432/camp_platform_dev"
# Secret used to sign the session cookie. Generate with: openssl rand -hex 32
JWT_SECRET="change-me-to-a-long-random-string"
# Public base URL of the site. Used in emails, payment redirects, and
# config/camp.config.ts. Falls back to the config website, then localhost.
APP_URL="http://localhost:3006"
NEXT_PUBLIC_APP_URL="http://localhost:3006"

# --- Email (optional) --------------------------------------------------------
# Transport priority: SendGrid, then SMTP, then log-only (emails are written
# to the server log and EmailLog table but not delivered).
# Defaults to "<camp name> <noreply@camp domain>" from config/camp.config.ts.
EMAIL_FROM=""
# Where payment notices are sent. Defaults to payments@<camp domain>.
PAYMENTS_EMAIL=""
SENDGRID_API_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# Optional group-chat invite link included in the welcome email. If unset the
# email says a camp lead will add the new member manually.
WHATSAPP_INVITE_URL=""

# --- Payments (optional) -----------------------------------------------------
# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# PayPal (PAYPAL_ENV is "sandbox" or "live")
PAYPAL_ENV="sandbox"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
NEXT_PUBLIC_PAYPAL_CLIENT_ID=""

# --- Google Sheets backup (optional) -----------------------------------------
# Service-account credentials for syncing the Master Document to a Google
# Sheet. Share the target spreadsheet with the service-account email.
GOOGLE_SHEETS_CLIENT_EMAIL=""
# Paste the private key with literal \n sequences for newlines.
GOOGLE_SHEETS_PRIVATE_KEY=""
GOOGLE_SHEETS_BACKUP_SPREADSHEET_ID=""
# Shared secret for the scheduled backup endpoint (/api/cron/backup-google-sheet).
# Send it as "Authorization: Bearer <secret>" or an "x-cron-secret" header.
# BACKUP_CRON_SECRET takes precedence over CRON_SECRET.
BACKUP_CRON_SECRET=""
CRON_SECRET=""

# --- Analytics (optional) ----------------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# --- Deployment metadata (optional) ------------------------------------------
# Surfaced by /api/health to identify what is running.
DEPLOY_BRANCH=""
DEPLOY_RESOURCE_ID=""

# --- Runtime -----------------------------------------------------------------
NODE_ENV="development"
